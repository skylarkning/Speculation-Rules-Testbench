{
  "manifest_version": 3,
  "name": "Speculation Rules Testbench",
  "version": "1.3.1",
  "description": "Inspect Firefox Speculation Rules, record speculative requests, run a blocked-prefetch control, and export the evidence.",
  "browser_specific_settings": {
    "gecko": {
      "id": "speculation-rules-testbench@mozilla.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "browsingData",
    "scripting",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "devtools_page": "devtools/devtools.html",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
